:host {
  display: block;
  height: 100%;
}

.experiment-card {
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
  height: 100%;
  padding: 1.5rem;
  background: #171a21;
  color: #f5f6f8;
  border: 1px solid #433452;
  border-radius: 16px;
  transition:
    border-color 200ms ease,
    box-shadow 200ms ease,
    transform 200ms ease;

  &:hover {
    border-color: #8752c4;
    box-shadow: 0 12px 32px rgba(109, 0, 217, 0.12);
    transform: translateY(-3px);
  }

  &__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  &__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3.75rem;
    height: 3.75rem;
    font-size: 2rem;
    line-height: 1;
    flex-shrink: 0;
    background: linear-gradient(
      135deg,
      rgba(109, 0, 217, 0.12),
      rgba(139, 92, 246, 0.22)
    );
    border: 1px solid rgba(139, 92, 246, 0.4);
    border-radius: 16px;
  }

  &__status {
    padding: 0.35rem 0.7rem;
    border-radius: 999px;
    background: #3b3020;
    color: #f5c77a;
    font-size: 0.75rem;
    font-weight: 600;

    &--live {
      background: #183b30;
      color: #82dfb3;
    }
  }

  &__content {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  &__title {
    margin: 0;
    color: inherit;
    font-size: 1.5rem;
    letter-spacing: -0.025em;
    font-weight: 700;
    line-height: 1.3;
  }

  &__tagline {
    margin: 0;
    color: #e2e5eb;
    font-size: 0.95rem;
    line-height: 1.5;
  }

  &__description {
    margin: 0;
    color: #aeb6c4;
    font-size: 0.875rem;
    line-height: 1.6;
  }
}

@media (max-width: 600px) {
  .experiment-card {
    padding: 1.25rem;
  }
}


// Acción de navegación del experimento
.experiment-card__link {
  display: inline-flex;
  align-items: center;
  align-self: flex-start;
  gap: 0.5rem;
  margin-top: auto;

  font-size: 0.9rem;
  font-weight: 600;
  line-height: 1.5;
  text-decoration: none;

  color: #a78bfa;

  .experiment-card__link-text {
    background: linear-gradient(90deg, #3b82f6, #6d00d9);
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  transition: opacity 180ms ease;

  &:hover {
    opacity: 0.8;
  }

  &:focus-visible {
    outline: 2px solid #a78bfa;
    outline-offset: 5px;
    border-radius: 3px;
  }

  i {
    font-size: 1rem;
    transition: transform 180ms ease;
  }

  &:hover i {
    transform: translateX(3px);
  }
}


// Portada editorial de experimentos Orbit (690 × 885)
.experiment-card__cover {
  width: 100%;
  aspect-ratio: 690 / 885;
  overflow: hidden;
  border-radius: 12px;
  background: #21172e;
  border: 1px solid #433452;

  img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
}
