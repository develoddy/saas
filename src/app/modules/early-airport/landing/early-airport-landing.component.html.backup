<div class="early-airport">
  <div class="card">
    <span class="label">EARLY AIRPORT</span>

    <h1 class="headline">What if your airport ride cancels at 3 AM?</h1>

    <p class="subheadline">
      Already booked a ride for your early flight? Explore a backup option
      so you are not left searching for another driver at the last minute.
    </p>

    <form *ngIf="!submitted" [formGroup]="tripForm" (ngSubmit)="checkAvailability()" class="trip-form">
      <div class="field">
        <label for="origin_city">From</label>
        <input id="origin_city" type="text" formControlName="origin_city" placeholder="City / area">
        <small class="error" *ngIf="tripForm.get('origin_city')?.invalid && tripForm.get('origin_city')?.touched">Required</small>
      </div>

      <div class="field">
        <label for="airport">Airport</label>
        <input id="airport" type="text" formControlName="airport" placeholder="Airport">
        <small class="error" *ngIf="tripForm.get('airport')?.invalid && tripForm.get('airport')?.touched">Required</small>
      </div>

      <div class="field">
        <label for="flight_date">Flight date</label>
        <input id="flight_date" type="date" formControlName="flight_date">
        <small class="error" *ngIf="tripForm.get('flight_date')?.invalid && tripForm.get('flight_date')?.touched">Required</small>
      </div>

      <div class="field">
        <label for="flight_time">Flight time</label>
        <input id="flight_time" type="time" formControlName="flight_time">
        <small class="error" *ngIf="tripForm.get('flight_time')?.invalid && tripForm.get('flight_time')?.touched">Required</small>
      </div>

      <button type="submit" class="cta">Check backup options</button>
    </form>

    <div *ngIf="submitted" class="unavailable-state">
      <p class="unavailable-title">This is an early experiment.</p>
      <p class="unavailable-text">
        We don't have backup drivers available yet for this route.
        We're testing whether travellers actually want a backup option
        before building the real service.
      </p>

      <button *ngIf="!backupRequested" type="button" class="cta secondary" (click)="requestBackup()">
        I want a backup option
      </button>
      <p class="backup-confirmed" *ngIf="backupRequested">Thanks, we've noted your interest in a backup option.</p>

      <ng-container *ngIf="!emailSubmitted; else thanks">
        <p class="notify-question">Want to know if we launch a backup option?</p>
        <form [formGroup]="emailForm" (ngSubmit)="notifyMe()" class="email-form">
          <input type="email" formControlName="email" placeholder="your@email.com">
          <button type="submit" class="cta">Notify me</button>
        </form>
        <small class="disclaimer">No spam. Just an update if we continue with this.</small>
      </ng-container>

      <ng-template #thanks>
        <p class="thanks">Thanks! We'll let you know.</p>
      </ng-template>
    </div>
  </div>
</div>
